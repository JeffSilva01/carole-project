---
/*
  QuoteForm.astro — formulário de cotação. Envia via WhatsApp por padrão (sem backend).
*/
import Icon from "@/components/Icon.astro"
import { site } from "@/lib/site"
---

<form id="quote-form" class="grid gap-5" novalidate>
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <label for="q-nome" class="mb-1.5 block text-sm font-medium text-navy-700">Nome completo</label>
      <input
        id="q-nome"
        name="nome"
        type="text"
        required
        autocomplete="name"
        placeholder="Seu nome"
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors placeholder:text-muted-foreground focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      />
    </div>

    <div>
      <label for="q-whatsapp" class="mb-1.5 block text-sm font-medium text-navy-700">WhatsApp</label>
      <input
        id="q-whatsapp"
        name="whatsapp"
        type="tel"
        required
        autocomplete="tel"
        placeholder="(11) 99999-0000"
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors placeholder:text-muted-foreground focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      />
    </div>

    <div>
      <label for="q-cidade" class="mb-1.5 block text-sm font-medium text-navy-700">Cidade</label>
      <input
        id="q-cidade"
        name="cidade"
        type="text"
        required
        autocomplete="address-level2"
        placeholder="Sua cidade"
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors placeholder:text-muted-foreground focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      />
    </div>

    <div>
      <label for="q-idade" class="mb-1.5 block text-sm font-medium text-navy-700">Idade</label>
      <input
        id="q-idade"
        name="idade"
        type="number"
        min="0"
        max="120"
        placeholder="Ex: 35"
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors placeholder:text-muted-foreground focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      />
    </div>

    <div>
      <label for="q-tipo" class="mb-1.5 block text-sm font-medium text-navy-700">Tipo de plano</label>
      <select
        id="q-tipo"
        name="tipo"
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      >
        <option value="Individual">Individual</option>
        <option value="Familiar">Familiar</option>
        <option value="Empresarial">Empresarial</option>
        <option value="Por Adesão">Por Adesão</option>
      </select>
    </div>

    <div>
      <label for="q-pessoas" class="mb-1.5 block text-sm font-medium text-navy-700">Quantidade de pessoas</label>
      <input
        id="q-pessoas"
        name="pessoas"
        type="number"
        min="1"
        placeholder="Ex: 3"
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors placeholder:text-muted-foreground focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      />
    </div>

    <div class="sm:col-span-2">
      <label for="q-mensagem" class="mb-1.5 block text-sm font-medium text-navy-700">Mensagem (opcional)</label>
      <textarea
        id="q-mensagem"
        name="mensagem"
        rows="4"
        placeholder="Conte um pouco sobre o que você procura..."
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors placeholder:text-muted-foreground focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      ></textarea>
    </div>
  </div>

  <button type="submit" class="btn-primary w-full py-4 text-base">
    <Icon name="message-circle" class="h-5 w-5" /> Receber Cotação
  </button>

  <p id="quote-status" class="hidden rounded-xl bg-brand-50 px-4 py-3 text-sm font-medium text-brand-700" role="status"></p>
</form>

<script define:vars={{ whatsapp: site.whatsapp }}>
  const form = document.getElementById("quote-form")
  const status = document.getElementById("quote-status")

  form?.addEventListener("submit", (e) => {
    e.preventDefault()
    const data = new FormData(form)
    const nome = data.get("nome")
    const whatsappField = data.get("whatsapp")
    const cidade = data.get("cidade")

    if (!nome || !whatsappField || !cidade) {
      if (status) {
        status.textContent = "Por favor, preencha nome, WhatsApp e cidade."
        status.classList.remove("hidden", "bg-brand-50", "text-brand-700")
        status.classList.add("bg-red-50", "text-red-700")
      }
      return
    }

    const msg =
      `Olá! Gostaria de solicitar uma cotação.%0A%0A` +
      `*Nome:* ${nome}%0A` +
      `*WhatsApp:* ${whatsappField}%0A` +
      `*Cidade:* ${cidade}%0A` +
      `*Idade:* ${data.get("idade") || "-"}%0A` +
      `*Tipo de plano:* ${data.get("tipo")}%0A` +
      `*Pessoas:* ${data.get("pessoas") || "-"}%0A` +
      `*Mensagem:* ${data.get("mensagem") || "-"}`

    if (status) {
      status.textContent = "Redirecionando para o WhatsApp..."
      status.classList.remove("hidden", "bg-red-50", "text-red-700")
      status.classList.add("bg-brand-50", "text-brand-700")
    }

    window.open(`https://wa.me/${whatsapp}?text=${msg}`, "_blank")
  })
</script>
