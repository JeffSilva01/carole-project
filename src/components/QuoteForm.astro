---
import { applicantTypes } from "@/lib/quote-applicant-types.mjs"
import Icon from "@/components/Icon.astro"
---

<form id="quote-form" class="grid gap-5" method="post" action="/api/quotes">
  <div class="grid gap-x-4 gap-y-3 sm:grid-cols-2">
    <div class="relative sm:col-span-2">
      <input
        id="q-name"
        name="name"
        maxlength="120"
        type="text"
        required
        autocomplete="name"
        placeholder=" "
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      />
      <label for="q-name" class="floating-label">Nome completo</label>
    </div>

    <div class="relative">
      <input
        id="q-whatsapp"
        name="whatsapp"
        maxlength="30"
        type="tel"
        required
        autocomplete="tel"
        placeholder=" "
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      />
      <label for="q-whatsapp" class="floating-label">WhatsApp</label>
    </div>

    <div class="relative">
      <input
        id="q-city"
        name="city"
        maxlength="120"
        type="text"
        required
        autocomplete="address-level2"
        placeholder=" "
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      />
      <label for="q-city" class="floating-label">Cidade</label>
    </div>

    <div class="relative">
      <input
        id="q-age"
        name="age"
        type="number"
        min="0"
        max="120"
        placeholder=" "
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      />
      <label for="q-age" class="floating-label">Idade</label>
    </div>

    <div class="relative">
      <input
        id="q-people-count"
        name="peopleCount"
        type="number"
        min="1"
        placeholder=" "
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      />
      <label for="q-people-count" class="floating-label">Quantidade de pessoas</label>
    </div>

    <fieldset class="min-w-0 sm:col-span-2">
      <legend class="mb-1 text-sm font-medium text-navy-700">Tipo de contratação</legend>
      <div class="flex flex-wrap gap-x-4">
        {applicantTypes.map(({ value, label }) => (
          <label class="flex min-h-8 cursor-pointer items-center gap-2 text-sm text-navy-700">
            <input type="radio" name="applicantType" value={value} required class="h-4 w-4 accent-brand-600" />
            {label}
          </label>
        ))}
      </div>
    </fieldset>

    <div class="relative sm:col-span-2">
      <textarea
        id="q-message"
        name="message"
        maxlength="1000"
        rows="4"
        placeholder=" "
        class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-navy-800 outline-none transition-colors focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
      ></textarea>
      <label for="q-message" class="floating-label">Mensagem (opcional)</label>
    </div>
  </div>

  <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} data-action="quote"></div>
  <button type="submit" class="btn-primary w-full py-4 text-base">
    <Icon name="message-circle" class="h-5 w-5" /> Receber Cotação
  </button>

  <p id="quote-status" class="hidden rounded-xl bg-brand-50 px-4 py-3 text-sm font-medium text-brand-700" role="status"></p>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline>
  const form = document.getElementById("quote-form")
  const quoteStatus = document.getElementById("quote-status")
  const submitButton = form.querySelector('button[type="submit"]')
  const widget = form.querySelector(".cf-turnstile")

  function showStatus(message, error = false) {
    quoteStatus.textContent = message
    quoteStatus.classList.remove("hidden")
    quoteStatus.classList.toggle("bg-red-50", error)
    quoteStatus.classList.toggle("text-red-700", error)
    quoteStatus.classList.toggle("bg-brand-50", !error)
    quoteStatus.classList.toggle("text-brand-700", !error)
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault()
    if (submitButton.disabled) return
    const data = new FormData(form)
    const token = data.get("cf-turnstile-response")
    if (!token) {
      showStatus("Aguarde ou conclua a validação de segurança para enviar.", true)
      return
    }

    const quote = {
      name: data.get("name").trim(),
      whatsapp: data.get("whatsapp").trim(),
      city: data.get("city").trim(),
      applicantType: data.get("applicantType"),
      token,
    }
    for (const field of ["age", "peopleCount"]) {
      const value = data.get(field)
      if (value !== "") quote[field] = Number(value)
    }
    const message = data.get("message").trim()
    if (message) quote.message = message

    submitButton.disabled = true
    showStatus("Enviando sua solicitação…")
    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(quote),
        signal: AbortSignal.timeout(15000),
      })
      if (response.status === 429) {
        showStatus("Aguarde um minuto antes de tentar novamente.", true)
        return
      }
      const { message } = await response.json()
      if (response.status === 201) form.reset()
      showStatus(message, response.status !== 201)
    } catch {
      showStatus("Não foi possível confirmar o envio. Tente novamente mais tarde.", true)
    } finally {
      submitButton.disabled = false
      window.turnstile?.reset(widget)
    }
  })
</script>

<style>
  .floating-label {
    position: absolute;
    inset-inline-start: 0.75rem;
    top: 0;
    transform: translateY(-50%);
    padding-inline: 0.25rem;
    background: white;
    color: var(--color-navy-700);
    font-size: 0.75rem;
    font-weight: 500;
    transition: top 150ms ease, transform 150ms ease, font-size 150ms ease;
  }

  :is(input, textarea):placeholder-shown:not(:focus):not(:autofill) + .floating-label {
    top: 0.75rem;
    transform: none;
    font-size: 0.875rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-label {
      transition: none;
    }
  }
</style>
