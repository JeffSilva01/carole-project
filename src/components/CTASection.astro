---
/*
  CTASection.astro — chamada final com botão WhatsApp (faixa de destaque)
*/
import { whatsappLink } from "@/lib/site"
import Icon from "@/components/Icon.astro"

interface Props {
  title?: string
  text?: string
  variant?: "brand" | "navy"
}
const {
  title = "Vamos encontrar o plano ideal para você.",
  text = "Fale com um consultor agora mesmo e receba uma orientação gratuita e sem compromisso.",
  variant = "brand",
} = Astro.props

const bg = variant === "brand" ? "bg-brand-500" : "bg-navy-800"
---

<section class="section">
  <div class="container-page">
    <div class={`relative overflow-hidden rounded-3xl ${bg} px-6 py-14 text-center sm:px-12 sm:py-16`}>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-2xl font-extrabold tracking-tight text-white text-balance sm:text-3xl lg:text-4xl">
          {title}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-white/85">{text}</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="btn w-full bg-white px-8 py-4 text-base text-brand-700 hover:bg-white/90 sm:w-auto"
          >
            <Icon name="message-circle" class="h-5 w-5" /> Falar no WhatsApp
          </a>
          <a
            href="/solicitar-cotacao"
            class="btn w-full border border-white/40 px-8 py-4 text-base text-white hover:bg-white/10 sm:w-auto"
          >
            Solicitar Cotação
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
