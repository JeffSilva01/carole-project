---
/*
  ArticleCard.astro — card de artigo do blog
*/
import type { BlogPost } from "@/lib/site"
import Icon from "@/components/Icon.astro"

interface Props {
  post: BlogPost
}
const { post } = Astro.props

const formattedDate = new Date(post.date).toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
})
---

<article class="card card-hover group flex flex-col overflow-hidden p-0">
  <a href={`/blog/${post.slug}`} class="block overflow-hidden">
    <img
      src={post.image}
      alt={post.title}
      width="800"
      height="500"
      loading="lazy"
      class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center gap-3 text-xs">
      <span class="rounded-full bg-brand-50 px-2.5 py-1 font-semibold text-brand-700">{post.category}</span>
      <span class="flex items-center gap-1 text-muted-foreground">
        <Icon name="calendar-days" class="h-3.5 w-3.5" /> {formattedDate}
      </span>
    </div>
    <h3 class="mt-3 text-lg font-bold leading-snug text-navy-800 text-balance">
      <a href={`/blog/${post.slug}`} class="transition-colors group-hover:text-brand-600">{post.title}</a>
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{post.excerpt}</p>
    <a
      href={`/blog/${post.slug}`}
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition-colors hover:text-brand-700"
    >
      Ler mais <Icon name="arrow-right" class="h-4 w-4" />
    </a>
  </div>
</article>
