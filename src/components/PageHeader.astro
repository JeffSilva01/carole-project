---
/*
  PageHeader.astro — banner de topo das páginas internas com breadcrumb
*/
import Breadcrumb from "@/components/Breadcrumb.astro"

interface Crumb {
  label: string
  href?: string
}
interface Props {
  title: string
  subtitle?: string
  eyebrow?: string
  breadcrumb?: Crumb[]
  breadcrumbs?: Crumb[]
}
const { title, subtitle, eyebrow, breadcrumb, breadcrumbs } = Astro.props
const crumbs = breadcrumbs ?? breadcrumb ?? []
---

<section class="border-b border-border bg-muted">
  <div class="container-page py-10 sm:py-14">
    <Breadcrumb items={crumbs} />
    {eyebrow && <span class="eyebrow mt-4">{eyebrow}</span>}
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-navy-800 text-balance sm:text-4xl lg:text-5xl">
      {title}
    </h1>
    {subtitle && <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">{subtitle}</p>}
  </div>
</section>
