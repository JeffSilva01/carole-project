---
/*
  Breadcrumb.astro — trilha de navegação para páginas internas
*/
import Icon from "@/components/Icon.astro"

interface Crumb {
  label: string
  href?: string
}
interface Props {
  items: Crumb[]
}
const { items } = Astro.props
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1.5 text-muted-foreground">
    <li>
      <a href="/" class="transition-colors hover:text-brand-600">Home</a>
    </li>
    {
      items.map((item) => (
        <li class="flex items-center gap-1.5">
          <Icon name="chevron-right" class="h-4 w-4 text-navy-100" />
          {item.href ? (
            <a href={item.href} class="transition-colors hover:text-brand-600">
              {item.label}
            </a>
          ) : (
            <span class="font-medium text-navy-700" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
