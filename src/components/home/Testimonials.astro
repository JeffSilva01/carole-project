---
/*
  Testimonials.astro — depoimentos em vídeo (placeholder) e em texto
*/
import { testimonials } from "@/lib/site"
import Icon from "@/components/Icon.astro"

const videoTestimonials = [
  { name: "Fernanda Souza", role: "Plano Familiar" },
  { name: "Ricardo Almeida", role: "Plano Empresarial" },
]
---

<section class="section bg-white">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow"><Icon name="star" class="h-4 w-4" /> Depoimentos</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy-800 text-balance sm:text-4xl">
        Histórias de quem já está protegido
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        A confiança de quem encontrou o plano ideal com a nossa ajuda.
      </p>
    </div>

    <!-- Depoimentos em vídeo -->
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        videoTestimonials.map((v) => (
          <div class="group relative aspect-video overflow-hidden rounded-2xl border border-border bg-navy-900">
            <img
              src={`https://placehold.co/720x405/16294a/6ee7a3?text=Depoimento+em+Vi%CC%81deo`}
              alt={`Depoimento em vídeo de ${v.name}`}
              width="720"
              height="405"
              loading="lazy"
              class="h-full w-full object-cover opacity-90 transition-transform duration-300 group-hover:scale-105"
            />
            <button
              type="button"
              class="absolute inset-0 flex items-center justify-center bg-navy-900/20 transition-colors hover:bg-navy-900/30"
              aria-label={`Reproduzir depoimento de ${v.name}`}
            >
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/90 text-brand-600 shadow-lg transition-transform group-hover:scale-110">
                <Icon name="play" class="h-7 w-7" />
              </span>
            </button>
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy-900/80 to-transparent p-4">
              <p class="font-semibold text-white">{v.name}</p>
              <p class="text-xs text-white/70">{v.role}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Depoimentos em texto -->
    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        testimonials.map((t) => (
          <figure class="card flex h-full flex-col">
            <Icon name="quote" class="h-7 w-7 text-brand-300" />
            <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-navy-700">"{t.quote}"</blockquote>
            <figcaption class="mt-4 border-t border-border pt-4">
              <p class="text-sm font-bold text-navy-800">{t.name}</p>
              <p class="text-xs text-muted-foreground">{t.role}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
