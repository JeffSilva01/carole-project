---
/*
  Testimonials.astro — depoimentos em vídeo (placeholder) e em texto
*/
import { testimonials } from "@/lib/site"
import Icon from "@/components/Icon.astro"

const videoTestimonials = [
  { name: "Fernanda Souza", role: "Plano Familiar" },
  { name: "Ricardo Almeida", role: "Plano Empresarial" },
]
---

<section class="section bg-white">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow"><Icon name="star" class="h-4 w-4" /> Depoimentos</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy-800 text-balance sm:text-4xl">
        Histórias de quem já está protegido
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        A confiança de quem encontrou o plano ideal com a nossa ajuda.
      </p>
    </div>

    <!-- Depoimentos em texto -->
    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        testimonials.map((t) => (
          <figure class="card flex h-full flex-col">
            <Icon name="quote" class="h-7 w-7 text-brand-300" />
            <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-navy-700">"{t.quote}"</blockquote>
            <figcaption class="mt-4 border-t border-border pt-4">
              <p class="text-sm font-bold text-navy-800">{t.name}</p>
              <p class="text-xs text-muted-foreground">{t.role}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
