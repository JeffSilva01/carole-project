---
import { site } from "@/lib/site"
import Icon from "@/components/Icon.astro"

const reels = [
  { title: "Como escolher seu plano", views: "12,4 mil" },
  { title: "Carência: o que você precisa saber", views: "8,9 mil" },
  { title: "Plano para MEI vale a pena?", views: "15,1 mil" },
  { title: "Erros ao contratar um plano", views: "22,3 mil" },
]
---

<section class="section bg-muted">
  <div class="container-page">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <span class="eyebrow"><Icon name="instagram" class="h-4 w-4" /> Instagram</span>
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy-800 text-balance sm:text-4xl">
          Conteúdo que ajuda você a escolher melhor seu plano
        </h2>
      </div>
      <a
        href={site.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary shrink-0"
      >
        <Icon name="instagram" class="h-5 w-5" /> Seguir no Instagram
      </a>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
      {
        reels.map((reel) => (
          <a
            href={site.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative aspect-9/16 overflow-hidden rounded-2xl border border-border bg-navy-900"
          >
            <img
              src={`https://placehold.co/360x640/16294a/6ee7a3?text=Reel`}
              alt={reel.title}
              width="360"
              height="640"
              loading="lazy"
              class="h-full w-full object-cover opacity-90 transition-transform duration-300 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/80 via-transparent to-transparent" />
            <span class="absolute left-1/2 top-1/2 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-brand-600 shadow-md transition-transform group-hover:scale-110">
              <Icon name="play" class="h-6 w-6" />
            </span>
            <div class="absolute inset-x-0 bottom-0 p-4">
              <p class="text-sm font-semibold leading-snug text-white text-balance">{reel.title}</p>
              <p class="mt-1 flex items-center gap-1 text-xs text-white/70">
                <Icon name="eye" class="h-3.5 w-3.5" /> {reel.views} visualizações
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
