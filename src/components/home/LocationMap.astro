---
const address = "Av. Treze de Maio, 1422 - Lj 17 - Fátima, Fortaleza - CE, 60040-531, Brasil"
const query = encodeURIComponent(address)
const embedUrl = `https://maps.google.com/maps?q=${query}&output=embed`
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${query}`
---

<section class="section bg-muted" id="location" aria-labelledby="location-title">
  <div class="container-page">
    <div class="mb-6">
      <h2 id="location-title" class="text-2xl font-bold text-navy-800 sm:text-3xl">
        Localização
      </h2>
      <p class="mt-2 text-muted-foreground">{address}</p>
      <a
        class="mt-3 inline-block font-semibold text-brand-700 underline underline-offset-4"
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Abrir no Google Maps
      </a>
    </div>

    <p class="mb-3 text-sm text-muted-foreground">Ao carregar o mapa, seu navegador se conecta ao Google Maps.</p>
    <button type="button" id="load-location-map" class="btn-secondary" aria-controls="location-map" aria-expanded="false">Carregar mapa</button>
    <iframe
      id="location-map"
      data-src={embedUrl}
      hidden
      title="Mapa da localização em Fortaleza"
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      class="h-80 w-full rounded-2xl border border-border bg-muted sm:h-96"
    ></iframe>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>("#load-location-map")
  const map = document.querySelector<HTMLIFrameElement>("#location-map")
  button?.addEventListener("click", () => {
    if (!map?.dataset.src) return
    map.src = map.dataset.src
    map.hidden = false
    button?.setAttribute("aria-expanded", "true")
    button!.disabled = true
  }, { once: true })
</script>
