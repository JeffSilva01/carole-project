---
/*
  HeroSection.astro — banner principal com vídeo/mensagem e CTAs
*/
import { whatsappLink } from "@/lib/site"
import Icon from "@/components/Icon.astro"
---

<section class="relative overflow-hidden bg-white">
  <div class="container-page grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
    <!-- Texto -->
    <div>
      <span class="eyebrow">
        <Icon name="shield-check" class="h-4 w-4" /> Consultoria especializada
      </span>
      <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight text-navy-800 text-balance sm:text-5xl lg:text-6xl">
        Escolher um plano de saúde não precisa ser complicado.
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground text-pretty">
        Estamos aqui para encontrar a melhor proteção para você e sua família — com atendimento consultivo,
        humano e sem custo adicional.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/#solicitar-cotacao" class="btn-primary px-8 py-4 text-base">
          Solicitar Cotação
        </a>
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary px-8 py-4 text-base"
        >
          <Icon name="message-circle" class="h-5 w-5" /> Falar no WhatsApp
        </a>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-muted-foreground">
        <span class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-brand-500" /> Sem compromisso</span>
        <span class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-brand-500" /> Atendimento humanizado</span>
        <span class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-brand-500" /> Principais operadoras</span>
      </div>
    </div>

    <!-- Vídeo / foto em destaque -->
    <div class="relative">
      <div class="relative overflow-hidden rounded-3xl border border-border shadow-xl shadow-navy-900/10">
        <img
          src="https://placehold.co/720x820/ecfdf3/16a34a?text=Vi%CC%81deo+da+Proprieta%CC%81ria"
          alt="Vídeo de apresentação da proprietária da Caroli Soluções em Saúde"
          width="720"
          height="820"
          loading="eager"
          class="h-full w-full object-cover"
        />
        <button
          type="button"
          class="absolute inset-0 flex items-center justify-center bg-navy-900/10 transition-colors hover:bg-navy-900/20"
          aria-label="Reproduzir vídeo de apresentação"
        >
          <span class="flex h-20 w-20 items-center justify-center rounded-full bg-white/90 text-brand-600 shadow-lg transition-transform hover:scale-105">
            <Icon name="play" class="h-8 w-8" />
          </span>
        </button>
      </div>
      <!-- Selo de confiança flutuante -->
      <div class="absolute -bottom-5 -left-5 hidden rounded-2xl border border-border bg-white p-4 shadow-lg sm:block">
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
            <Icon name="heart-handshake" class="h-6 w-6" />
          </span>
          <div>
            <p class="text-sm font-bold text-navy-800">+500 famílias</p>
            <p class="text-xs text-muted-foreground">protegidas com a Caroli</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
