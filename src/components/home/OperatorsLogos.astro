---
import { operators } from "@/lib/site"
---

<section class="section bg-white" id="operadoras">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight text-navy-800 text-balance sm:text-3xl">
        Trabalhamos com as principais operadoras do mercado
      </h2>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {
        operators.map((op) => (
          <div
            class="flex h-24 items-center justify-center overflow-hidden rounded-2xl border border-border"
          >
            {op.logoUrl && (
                <img
                  src={op.logoUrl}
                  alt={`Logo ${op.name}`}
                  loading="lazy"
                  class="h-full w-full object-contain"
                />
              )
            }
          </div>
        ))
      }
    </div>
  </div>
</section>
