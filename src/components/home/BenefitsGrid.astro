---
import { benefits } from "@/lib/site"
import Icon from "@/components/Icon.astro"
---

<section class="section bg-white">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow"><Icon name="sparkles" class="h-4 w-4" /> Por que a Caroli</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy-800 text-balance sm:text-4xl">
        Uma consultoria que trabalha por você
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        Mais do que vender um plano, ajudamos você a tomar a melhor decisão para sua saúde e a de quem você ama.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        benefits.map((b) => (
          <article class="card card-hover">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={b.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-5 text-lg font-bold text-navy-800">{b.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{b.description}</p>
          </article>
        ))
      }
      <!-- Featured card -->
      <article class="card flex flex-col justify-center bg-navy-800 text-white">
        <h3 class="text-lg font-bold text-white">Ainda com dúvidas?</h3>
        <p class="mt-2 text-sm leading-relaxed text-navy-100/80">
          Converse com uma consultora e receba orientação personalizada agora mesmo.
        </p>
        <a href="/#request-quote" class="btn mt-5 w-fit bg-brand-500 px-5 py-2.5 text-white hover:bg-brand-600">
          Solicitar Cotação <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </article>
    </div>
  </div>
</section>
