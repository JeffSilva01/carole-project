---
/*
  StepsSection.astro — seção "Como Funciona" em 3 etapas conectadas
*/
import { steps } from "@/lib/site"
---

<section class="section bg-muted">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Como funciona</span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-navy-800 text-balance sm:text-4xl">
        Simples do início ao fim
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        Em três passos você sai da dúvida para a decisão certa.
      </p>
    </div>

    <div class="relative mt-14">
      <!-- Linha conectora (desktop) -->
      <div class="absolute left-0 right-0 top-8 hidden h-0.5 bg-brand-100 lg:block" aria-hidden="true"></div>

      <ol class="grid gap-8 lg:grid-cols-3">
        {
          steps.map((step) => (
            <li class="relative text-center lg:text-left">
              <span class="relative z-10 mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-500 text-xl font-extrabold text-white shadow-md shadow-brand-600/20 lg:mx-0">
                {step.number}
              </span>
              <h3 class="mt-5 text-xl font-bold text-navy-800">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
