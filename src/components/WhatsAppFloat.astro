---
import { whatsappLink } from "@/lib/site"
import Icon from "@/components/Icon.astro"
---

<a
  href={whatsappLink()}
  target="_blank"
  rel="noopener noreferrer"
  class="group fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-brand-500 px-4 py-3.5 text-white shadow-lg shadow-brand-600/30 transition-all duration-200 hover:bg-brand-600 hover:shadow-xl"
  aria-label="Fale conosco no WhatsApp"
>
  <Icon name="message-circle" class="h-6 w-6" />
  <span class="hidden text-sm font-semibold sm:inline">Fale conosco</span>
</a>
