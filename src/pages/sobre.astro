---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";

const values = [
  {
    icon: "heart-handshake",
    title: "Humanização",
    description:
      "Tratamos cada cliente como parte da nossa história. Escutamos antes de indicar.",
  },
  {
    icon: "shield-check",
    title: "Transparência",
    description:
      "Explicamos tudo com clareza: coberturas, carências, reajustes e letras miúdas.",
  },
  {
    icon: "scale",
    title: "Imparcialidade",
    description:
      "Trabalhamos com diversas operadoras para indicar o que é melhor para você, não para nós.",
  },
  {
    icon: "sparkles",
    title: "Excelência",
    description:
      "Buscamos a melhor experiência em cada etapa, da primeira conversa ao pós-venda.",
  },
];
---

<BaseLayout
  title="Sobre"
  description="Conheça a Caroli Soluções em Saúde: missão, visão e valores de uma consultoria especializada em planos de saúde com atendimento humanizado."
>
  <PageHeader
    eyebrow="Quem somos"
    title="Uma consultoria feita de cuidado e confiança"
    subtitle="Ajudamos pessoas e empresas a encontrar o plano de saúde ideal, com um atendimento próximo, consultivo e sem complicação."
    breadcrumbs={[{ label: "Sobre" }]}
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="eyebrow">Nossa história</span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-navy-800 text-balance">
          Nascemos para descomplicar a saúde de quem a gente atende
        </h2>
        <div class="mt-6 space-y-4 text-muted-foreground leading-relaxed">
          <p>
            A Caroli Soluções em Saúde surgiu da vontade de transformar a forma
            como as pessoas contratam planos de saúde. Percebemos que o processo
            costuma ser confuso, cheio de termos técnicos e decisões difíceis.
          </p>
          <p>
            Por isso, criamos uma consultoria que coloca o cliente no centro.
            Comparamos as principais operadoras do mercado, traduzimos o que
            realmente importa e acompanhamos você antes, durante e depois da
            contratação.
          </p>
          <p>
            Hoje, atendemos famílias, profissionais autônomos e empresas de
            todos os portes, sempre com o mesmo compromisso: proteção com
            proximidade e respeito.
          </p>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="card text-center">
          <p class="text-4xl font-extrabold text-brand-500">+1.200</p>
          <p class="mt-2 text-sm text-muted-foreground">Clientes atendidos</p>
        </div>
        <div class="card text-center">
          <p class="text-4xl font-extrabold text-brand-500">+10</p>
          <p class="mt-2 text-sm text-muted-foreground">Operadoras parceiras</p>
        </div>
        <div class="card text-center">
          <p class="text-4xl font-extrabold text-brand-500">98%</p>
          <p class="mt-2 text-sm text-muted-foreground">Clientes satisfeitos</p>
        </div>
        <div class="card text-center">
          <p class="text-4xl font-extrabold text-brand-500">+8 anos</p>
          <p class="mt-2 text-sm text-muted-foreground">De experiência</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-muted">
    <div class="container-page">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="card">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
            <Icon name="target" class="h-6 w-6" />
          </div>
          <h3 class="mt-4 text-xl font-bold text-navy-800">Missão</h3>
          <p class="mt-2 text-muted-foreground leading-relaxed">
            Facilitar o acesso à saúde de qualidade, oferecendo consultoria
            transparente e humanizada para que cada cliente tome a melhor
            decisão.
          </p>
        </div>
        <div class="card">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
            <Icon name="eye" class="h-6 w-6" />
          </div>
          <h3 class="mt-4 text-xl font-bold text-navy-800">Visão</h3>
          <p class="mt-2 text-muted-foreground leading-relaxed">
            Ser referência em consultoria de planos de saúde, reconhecida pela
            confiança, proximidade e cuidado genuíno com as pessoas.
          </p>
        </div>
      </div>

      <div class="mt-12">
        <h3 class="text-center text-2xl font-bold text-navy-800">Nossos valores</h3>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            values.map((value) => (
              <div class="card card-hover text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                  <Icon name={value.icon} class="h-6 w-6" />
                </div>
                <h4 class="mt-4 font-semibold text-navy-800">{value.title}</h4>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                  {value.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
