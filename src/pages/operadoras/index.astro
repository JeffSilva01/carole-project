---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import CTASection from "@/components/CTASection.astro";
import Icon from "@/components/Icon.astro";
import { operators } from "@/lib/site";
---

<BaseLayout
  title="Operadoras Parceiras"
  description="Trabalhamos com as principais operadoras de planos de saúde do Brasil: Amil, Bradesco Saúde, SulAmérica, Unimed, NotreDame Intermédica e Hapvida."
>
  <PageHeader
    eyebrow="Operadoras parceiras"
    title="As melhores operadoras em um só lugar"
    subtitle="Comparamos as principais operadoras do mercado para indicar a que melhor atende às suas necessidades — de forma imparcial e transparente."
    breadcrumbs={[{ label: "Operadoras" }]}
  />

  <section class="section">
    <div class="container-page grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        operators.map((op) => (
          <a
            href={`/operadoras/${op.slug}`}
            class="card card-hover flex flex-col"
          >
            <div class="flex items-center gap-4">
              <div
                class="flex h-14 w-14 items-center justify-center rounded-2xl text-lg font-extrabold text-white"
                style={`background-color:${op.color}`}
                aria-hidden="true"
              >
                {op.name.charAt(0)}
              </div>
              <div>
                <h2 class="text-lg font-bold text-navy-800">{op.name}</h2>
                <p class="text-sm text-brand-600 font-medium">{op.tagline}</p>
              </div>
            </div>
            <p class="mt-4 text-sm text-muted-foreground leading-relaxed">
              {op.description}
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {op.segments.map((s) => (
                <span class="rounded-full bg-muted px-3 py-1 text-xs font-medium text-navy-700">
                  {s}
                </span>
              ))}
            </div>
            <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
              Ver detalhes
              <Icon name="arrow-right" class="h-4 w-4" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CTASection />
</BaseLayout>
