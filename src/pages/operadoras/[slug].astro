---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import CTASection from "@/components/CTASection.astro";
import Icon from "@/components/Icon.astro";
import { operators, whatsappLink } from "@/lib/site";

export function getStaticPaths() {
  return operators.map((op) => ({
    params: { slug: op.slug },
    props: { operator: op },
  }));
}

const { operator } = Astro.props;
---

<BaseLayout
  title={`${operator.name} — Planos de Saúde`}
  description={`${operator.description} Fale com a Caroli e contrate ${operator.name} com consultoria gratuita.`}
>
  <PageHeader
    eyebrow="Operadora parceira"
    title={operator.name}
    subtitle={operator.tagline}
    breadcrumbs={[
      { label: "Operadoras", href: "/operadoras" },
      { label: operator.name },
    ]}
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-3 lg:items-start">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-4">
          <div
            class="flex h-16 w-16 items-center justify-center rounded-2xl text-2xl font-extrabold text-white"
            style={`background-color:${operator.color}`}
            aria-hidden="true"
          >
            {operator.name.charAt(0)}
          </div>
          <div>
            <h2 class="text-2xl font-bold text-navy-800">{operator.name}</h2>
            <p class="text-brand-600 font-medium">{operator.tagline}</p>
          </div>
        </div>

        <p class="mt-6 text-muted-foreground leading-relaxed text-lg">
          {operator.description}
        </p>

        <h3 class="mt-10 text-xl font-bold text-navy-800">Diferenciais</h3>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {
            operator.highlights.map((h) => (
              <li class="flex items-start gap-3 rounded-2xl border border-border bg-muted p-4">
                <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-brand-500" />
                <span class="text-sm font-medium text-navy-700">{h}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="mt-10 text-xl font-bold text-navy-800">
          Segmentos disponíveis
        </h3>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            operator.segments.map((s) => (
              <span class="rounded-full bg-brand-50 px-4 py-1.5 text-sm font-medium text-brand-700">
                {s}
              </span>
            ))
          }
        </div>
      </div>

      <aside class="lg:sticky lg:top-24">
        <div class="card">
          <h3 class="text-lg font-bold text-navy-800">
            Interessado na {operator.name}?
          </h3>
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
            Fazemos a cotação para você sem custo e comparamos com outras
            operadoras para garantir a melhor escolha.
          </p>
          <div class="mt-5 flex flex-col gap-3">
            <a
              href={whatsappLink(`Olá! Gostaria de uma cotação da ${operator.name}.`)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp w-full"
            >
              <Icon name="message-circle" class="h-4 w-4" />
              Cotação no WhatsApp
            </a>
            <a href="/solicitar-cotacao" class="btn-secondary w-full">
              Solicitar Cotação
            </a>
          </div>
        </div>

        <a
          href="/operadoras"
          class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600"
        >
          <Icon name="chevron-right" class="h-4 w-4 rotate-180" />
          Ver todas as operadoras
        </a>
      </aside>
    </div>
  </section>

  <CTASection variant="navy" />
</BaseLayout>
