---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import QuoteForm from "@/components/QuoteForm.astro";
import Icon from "@/components/Icon.astro";

const reassurances = [
  { icon: "shield-check", text: "Seus dados são tratados com total sigilo" },
  { icon: "clock", text: "Retornamos em até 1 dia útil" },
  { icon: "scale", text: "Comparamos várias operadoras para você" },
  { icon: "heart-handshake", text: "Consultoria 100% gratuita" },
];
---

<BaseLayout
  title="Solicitar Cotação"
  description="Solicite uma cotação gratuita de plano de saúde. Preencha o formulário e receba as melhores opções para o seu perfil, sem compromisso."
>
  <PageHeader
    eyebrow="Cotação gratuita"
    title="Receba as melhores opções para o seu perfil"
    subtitle="Preencha o formulário abaixo. É rápido, gratuito e sem compromisso — nós cuidamos do resto."
    breadcrumbs={[{ label: "Solicitar Cotação" }]}
  />

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-3 lg:items-start">
      <div class="lg:col-span-2">
        <div class="card">
          <QuoteForm />
        </div>
      </div>

      <aside class="space-y-4">
        <div class="card">
          <h2 class="text-lg font-bold text-navy-800">Por que solicitar aqui?</h2>
          <ul class="mt-4 space-y-4">
            {
              reassurances.map((item) => (
                <li class="flex items-start gap-3">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                    <Icon name={item.icon} class="h-5 w-5" />
                  </div>
                  <p class="text-sm font-medium text-navy-700 leading-relaxed">
                    {item.text}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card bg-navy-800 text-white">
          <h2 class="text-lg font-bold">Prefere falar agora?</h2>
          <p class="mt-2 text-sm text-white/80 leading-relaxed">
            Fale diretamente com um consultor pelo WhatsApp e tire suas dúvidas
            em tempo real.
          </p>
          <a
            href="https://wa.me/5511999990000"
            target="_blank"
            rel="noopener noreferrer"
            class="btn mt-5 w-full bg-brand-500 text-white hover:bg-brand-600"
          >
            <Icon name="message-circle" class="h-4 w-4" />
            Chamar no WhatsApp
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
