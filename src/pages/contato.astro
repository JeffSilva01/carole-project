---
import BaseLayout from "@/layouts/BaseLayout.astro"
import PageHeader from "@/components/PageHeader.astro"
import QuoteForm from "@/components/QuoteForm.astro"
import Icon from "@/components/Icon.astro"
import { site, whatsappLink } from "@/lib/site"

const contacts = [
  {
    icon: "message-circle",
    label: "WhatsApp",
    value: site.phone,
    href: whatsappLink(),
    note: "Resposta rápida no horário comercial",
  },
  {
    icon: "phone",
    label: "Telefone",
    value: site.phone,
    href: `tel:${site.phoneRaw}`,
    note: site.hours,
  },
  {
    icon: "mail",
    label: "E-mail",
    value: site.email,
    href: `mailto:${site.email}`,
    note: "Retornamos em até 1 dia útil",
  },
  {
    icon: "map-pin",
    label: "Endereço",
    value: site.address,
    href: null,
    note: "Atendimento presencial com hora marcada",
  },
]

const socials = [
  { icon: "instagram", label: "Instagram", href: site.social.instagram },
  { icon: "facebook", label: "Facebook", href: site.social.facebook },
  { icon: "linkedin", label: "LinkedIn", href: site.social.linkedin },
  { icon: "youtube", label: "YouTube", href: site.social.youtube },
]
---

<BaseLayout
    title="Contato"
  description="Entre em contato com a Caroli Soluções em Saúde. Estamos prontos para ajudar você a encontrar o plano de saúde ideal."
>
  <PageHeader
    eyebrow="Contato"
    title="Vamos conversar sobre a sua saúde"
    subtitle="Estamos à disposição para tirar suas dúvidas e encontrar a melhor proteção para você. Escolha o canal que preferir."
    breadcrumbs={[{ label: "Contato" }]}
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        <h2 class="text-2xl font-bold text-navy-800">Canais de atendimento</h2>
        <p class="mt-2 text-muted-foreground leading-relaxed">
          Fale com a gente pelo canal mais conveniente. Nosso atendimento é humano, sem robôs e sem enrolação.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            contacts.map((c) => {
              const inner = (
                <div class="card card-hover h-full">
                  <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                    <Icon name={c.icon} class="h-5 w-5" />
                  </div>
                  <p class="mt-4 text-sm font-semibold text-navy-800">{c.label}</p>
                  <p class="mt-1 text-sm text-muted-foreground">{c.value}</p>
                  <p class="mt-2 text-xs text-muted-foreground/80">{c.note}</p>
                </div>
              )
              return c.href ? (
                <a href={c.href} target={c.icon === "message-circle" ? "_blank" : undefined} rel="noopener">
                  {inner}
                </a>
              ) : (
                inner
              )
            })
          }
        </div>

        <div class="mt-8">
          <p class="text-sm font-semibold text-navy-800">Siga a Caroli nas redes</p>
          <div class="mt-3 flex gap-3">
            {
              socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={s.label}
                  class="flex h-11 w-11 items-center justify-center rounded-full border border-border bg-white text-navy-600 transition-colors hover:border-brand-300 hover:text-brand-600"
                >
                  <Icon name={s.icon} class="h-5 w-5" />
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <div class="card">
        <h2 class="text-2xl font-bold text-navy-800">Envie uma mensagem</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Preencha o formulário e retornaremos o mais rápido possível.
        </p>
        <div class="mt-6">
          <QuoteForm compact />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
