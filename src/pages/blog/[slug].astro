---
import BaseLayout from "@/layouts/BaseLayout.astro"
import PageHeader from "@/components/PageHeader.astro"
import ArticleCard from "@/components/ArticleCard.astro"
import CTASection from "@/components/CTASection.astro"
import Icon from "@/components/Icon.astro"
import { blogPosts, whatsappLink } from "@/lib/site"

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props

const formattedDate = new Date(post.date).toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
})

const related = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 3)
---

<BaseLayout title={`${post.title} — Blog Caroli`} description={post.excerpt}>
  <PageHeader
    title={post.title}
    breadcrumbs={[{ label: "Blog", href: "/blog" }, { label: post.category }]}
  />

  <article class="section">
    <div class="container-page max-w-3xl">
      <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
        <span class="rounded-full bg-brand-50 px-3 py-1 font-semibold text-brand-700">{post.category}</span>
        <span class="flex items-center gap-1.5">
          <Icon name="calendar-days" class="h-4 w-4" /> {formattedDate}
        </span>
        <span class="flex items-center gap-1.5">
          <Icon name="clock" class="h-4 w-4" /> {post.readingTime} de leitura
        </span>
      </div>

      <div class="mt-6 overflow-hidden rounded-3xl border border-border">
        <img
          src={post.image}
          alt={post.title}
          width="800"
          height="500"
          class="aspect-video w-full object-cover"
        />
      </div>

      <p class="mt-8 text-lg font-medium leading-relaxed text-navy-700">{post.excerpt}</p>

      <div class="mt-8 space-y-8">
        {
          post.body.map((section) => (
            <section>
              {section.heading && (
                <h2 class="text-2xl font-bold text-navy-800 text-balance">{section.heading}</h2>
              )}
              <div class="mt-3 space-y-4 text-muted-foreground leading-relaxed">
                {section.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <div class="mt-10 rounded-2xl border border-brand-100 bg-brand-50 p-6 text-center">
        <p class="text-lg font-semibold text-navy-800">Ficou com dúvidas sobre o seu plano?</p>
        <p class="mt-2 text-sm text-muted-foreground">
          Fale com a Caroli e receba uma consultoria gratuita e sem compromisso.
        </p>
        <a href={whatsappLink()} class="btn-whatsapp mt-4">
          <Icon name="message-circle" class="h-4 w-4" />
          Falar no WhatsApp
        </a>
      </div>
    </div>
  </article>

  <section class="section bg-muted">
    <div class="container-page">
      <h2 class="text-2xl font-bold text-navy-800">Continue lendo</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => <ArticleCard post={p} />)}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
