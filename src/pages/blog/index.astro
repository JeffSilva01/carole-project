---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import CTASection from "@/components/CTASection.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Icon from "@/components/Icon.astro";
import { blogPosts, blogCategories } from "@/lib/site";

const featured = blogPosts[0];
const rest = blogPosts.slice(1);
---

<BaseLayout
  title="Blog"
  description="Conteúdo sobre planos de saúde, carência, coberturas, dicas de bem-estar e novidades das operadoras. Aprenda a escolher melhor com a Caroli."
>
  <PageHeader
    eyebrow="Blog"
    title="Conteúdo para você decidir melhor"
    subtitle="Artigos claros e práticos sobre planos de saúde, coberturas, carências e bem-estar."
    breadcrumbs={[{ label: "Blog" }]}
  />

  <section class="section">
    <div class="container-page">
      <!-- Categorias -->
      <div class="flex flex-wrap gap-2">
        <span class="rounded-full bg-brand-500 px-4 py-1.5 text-sm font-medium text-white">
          Todos
        </span>
        {
          blogCategories.map((cat) => (
            <a
              href={`/blog?categoria=${encodeURIComponent(cat)}`}
              class="rounded-full bg-muted px-4 py-1.5 text-sm font-medium text-navy-700 transition-colors hover:bg-brand-50 hover:text-brand-700"
            >
              {cat}
            </a>
          ))
        }
      </div>

      <!-- Destaque -->
      <a
        href={`/blog/${featured.slug}`}
        class="card card-hover mt-8 grid gap-6 overflow-hidden md:grid-cols-2 md:items-center"
      >
        <div class="overflow-hidden rounded-2xl">
          <img
            src={featured.image}
            alt={featured.title}
            class="aspect-[16/10] w-full object-cover"
            width="800"
            height="500"
            loading="lazy"
          />
        </div>
        <div>
          <span class="eyebrow">{featured.category}</span>
          <h2 class="mt-3 text-2xl font-bold text-navy-800 text-balance">
            {featured.title}
          </h2>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            {featured.excerpt}
          </p>
          <div class="mt-4 flex items-center gap-4 text-sm text-muted-foreground">
            <span class="flex items-center gap-1">
              <Icon name="calendar-days" class="h-4 w-4" />
              {new Date(featured.date).toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" })}
            </span>
            <span class="flex items-center gap-1">
              <Icon name="clock" class="h-4 w-4" />
              {featured.readingTime}
            </span>
          </div>
          <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
            Ler artigo <Icon name="arrow-right" class="h-4 w-4" />
          </span>
        </div>
      </a>

      <!-- Grid de artigos -->
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((post) => <ArticleCard post={post} />)}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
