---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import { site, whatsappLink } from "../lib/site";

const credentials = [
  { icon: "award", label: "Corretora certificada e habilitada pela SUSEP" },
  { icon: "trending-up", label: "+8 anos de experiência no mercado de saúde" },
  { icon: "users", label: "+1.200 clientes atendidos com dedicação" },
  { icon: "heart-handshake", label: "Especialista em atendimento consultivo" },
];
---

<BaseLayout
  title="A Proprietária"
  description="Conheça Caroline, fundadora da Caroli Soluções em Saúde. Uma especialista dedicada a encontrar o plano de saúde ideal com atendimento humano e consultivo."
>
  <PageHeader
    eyebrow="A Proprietária"
    title="Conheça quem cuida de você"
    subtitle="Por trás da Caroli existe uma profissional apaixonada por ajudar pessoas a encontrarem a proteção que merecem."
    breadcrumbs={[{ label: "A Proprietária" }]}
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-5 lg:items-start">
      <div class="lg:col-span-2">
        <div class="overflow-hidden rounded-3xl border border-border shadow-sm">
          <img
            src="/images/proprietaria.png"
            alt="Caroline, fundadora da Caroli Soluções em Saúde"
            class="aspect-[4/5] w-full object-cover"
            width="480"
            height="600"
          />
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <a href={whatsappLink()} class="btn-whatsapp w-full">
            <Icon name="message-circle" class="h-4 w-4" />
            WhatsApp
          </a>
          <a href="/contato" class="btn-secondary w-full">
            <Icon name="mail" class="h-4 w-4" />
            Contato
          </a>
        </div>
      </div>

      <div class="lg:col-span-3">
        <span class="eyebrow">Olá, eu sou a Caroline</span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-navy-800 text-balance">
          Minha missão é descomplicar a sua saúde
        </h2>
        <div class="mt-6 space-y-4 text-muted-foreground leading-relaxed">
          <p>
            Sou Caroline, fundadora da Caroli Soluções em Saúde. Ao longo da
            minha trajetória, percebi que escolher um plano de saúde gera muitas
            dúvidas e inseguranças — e foi aí que decidi fazer diferente.
          </p>
          <p>
            Acredito em um atendimento que começa com escuta. Antes de indicar
            qualquer plano, eu entendo o seu momento de vida, sua rotina, seu
            orçamento e o que é realmente importante para você e sua família.
          </p>
          <p>
            Trabalho com as principais operadoras do mercado justamente para ter
            liberdade de indicar a melhor opção para cada pessoa — sempre com
            transparência sobre coberturas, carências e valores.
          </p>
          <p>
            Mais do que fechar um contrato, eu construo relacionamentos. Estou
            aqui antes, durante e depois da contratação, sempre que você precisar.
          </p>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            credentials.map((item) => (
              <div class="flex items-start gap-3 rounded-2xl border border-border bg-muted p-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                  <Icon name={item.icon} class="h-5 w-5" />
                </div>
                <p class="text-sm font-medium text-navy-700">{item.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-muted">
    <div class="container-page max-w-3xl text-center">
      <Icon name="quote" class="mx-auto h-10 w-10 text-brand-400" />
      <blockquote class="mt-6 text-2xl font-medium text-navy-800 leading-relaxed text-balance">
        "Não vendo planos de saúde. Eu ajudo pessoas a dormirem tranquilas
        sabendo que estão protegidas."
      </blockquote>
      <p class="mt-6 font-semibold text-brand-600">Caroline</p>
      <p class="text-sm text-muted-foreground">Fundadora — {site.name}</p>
    </div>
  </section>

  <CTASection />
</BaseLayout>
